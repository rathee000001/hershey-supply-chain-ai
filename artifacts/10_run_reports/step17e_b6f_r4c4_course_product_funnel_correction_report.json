function PipelineNode({
  step,
  active,
  onActivate,
}: {
  step: PipelineStep;
  active: boolean;
  onActivate: () => void;
}) {
  const Icon = step.icon;

  return (
    <motion.button
      type="button"
      onMouseEnter={onActivate}
      onFocus={onActivate}
      onClick={onActivate}
      className={cx(
        "group relative min-h-[116px] rounded-[1.6rem] border p-4 text-left shadow-lg shadow-slate-200/50 transition duration-300",
        active
          ? "border-[#1f62ff]/45 bg-[#eef4ff] shadow-[#1f62ff]/10"
          : "border-[#2a0805]/10 bg-white/92 hover:border-[#d6a526]/45 hover:bg-[#fffaf3]",
      )}
      whileHover={{ y: -4 }}
      whileTap={{ scale: 0.98 }}
    >
      <div className="flex items-start gap-3">
        <div
          className={cx(
            "grid h-12 w-12 shrink-0 place-items-center rounded-2xl border bg-white transition",
            active ? "border-[#1f62ff]/30 text-[#1f62ff]" : "border-[#2a0805]/10 text-[#d6a526]",
          )}
        >
          <Icon size={20} />
        </div>

        <div>
          <p className="text-[10px] font-black uppercase tracking-[0.18em] text-[#9aa8bd]">
            {step.number}
          </p>
          <h3 className="mt-1 text-lg font-black leading-tight text-[#09040a]">
            {step.shortTitle}
          </h3>
        </div>
      </div>

      <p className="mt-4 text-xs font-semibold leading-5 text-[#5c4a40]">
        {step.summary}
      </p>

      {active ? (
        <motion.span
          layoutId="home-pipeline-active-glow"
          className="absolute inset-0 -z-10 rounded-[1.6rem] bg-[#1f62ff]/6"
          transition={{ type: "spring", stiffness: 360, damping: 32 }}
        />
      ) : null}
    </motion.button>
  );
}
