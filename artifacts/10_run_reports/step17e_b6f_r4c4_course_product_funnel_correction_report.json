    icon: FileText,
  },
  {
    id: "parser",
    number: "02",
    eyebrow: "MEMORY",
    title: "Parser + OCR memory",
    shortTitle: "Parser",
    summary: "Documents and visuals are prepared for downstream evidence reasoning.",
    detail:
      "Parser/OCR memory helps organize extracted text and visual notes. It supports the research workflow but does not directly publish website claims.",
    icon: Search,
  },
  {
    id: "rag",
    number: "03",
    eyebrow: "INDEX",
    title: "RAG/vector evidence index",
    shortTitle: "RAG Index",
    summary: "Searchable evidence memory supports structured analysis.",
    detail:
      "The retrieval layer helps reason across source fragments. Frontend claims remain gated by approved public JSON artifacts rather than raw retrieval output.",
    icon: Brain,
  },
  {
    id: "audit",
