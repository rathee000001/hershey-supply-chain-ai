    icon: ShieldCheck,
  },
  {
    id: "packets",
    number: "05",
    eyebrow: "STRUCTURE",
    title: "Supplier/ingredient packets",
    shortTitle: "Packets",
    summary: "Approved artifacts organize supplier and ingredient context.",
    detail:
      "Supplier and ingredient packets are structured for display from approved artifacts. This component does not hardcode supplier facts or evidence counts.",
    icon: Package,
  },
  {
    id: "cost",
    number: "06",
    eyebrow: "BENCHMARK",
    title: "Cost model artifacts",
    shortTitle: "Cost",
    summary: "Benchmark cost logic is separated from internal or invoice claims.",
    detail:
      "Cost artifacts are treated as benchmark study outputs. They are not Hershey internal costs, invoices, margins, or profit calculations.",
