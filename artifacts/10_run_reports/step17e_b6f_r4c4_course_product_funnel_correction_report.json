                  }
                  transition={{
                    duration: 9 + index * 0.6,
                    delay: index * 0.18,
                    repeat: Infinity,
                    ease: "easeInOut",
                  }}
                />
              ))}
            </svg>

            <div className="relative z-10 grid gap-4 sm:grid-cols-3">
              {pipelineSteps.slice(0, 3).map((step) => (
                <PipelineNode
                  key={step.id}
