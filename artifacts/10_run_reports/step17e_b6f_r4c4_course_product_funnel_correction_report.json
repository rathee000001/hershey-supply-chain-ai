              ))}
            </div>

            <div className="relative z-10 mt-5 grid gap-4 sm:grid-cols-3">
              <div />
              {pipelineSteps.slice(3, 5).map((step) => (
                <PipelineNode
                  key={step.id}
                  step={step}
                  active={activeStep.id === step.id}
                  onActivate={() => setActiveId(step.id)}
                />
              ))}
            </div>

            <div className="relative z-10 mt-5 grid gap-4 sm:grid-cols-3">
              {pipelineSteps.slice(5, 7).map((step) => (
                <PipelineNode
                  key={step.id}
                  step={step}
                  active={activeStep.id === step.id}
                  onActivate={() => setActiveId(step.id)}
                />
              ))}
              <div className="hidden items-center justify-center rounded-[1.5rem] border border-dashed border-[#2a0805]/12 bg-white/50 p-4 text-[#2a0805]/35 sm:flex">
                <ArrowRight />
              </div>
            </div>

            <div className="relative z-10 mt-6 rounded-[1.75rem] border border-[#2a0805]/10 bg-white/86 p-5 shadow-lg shadow-slate-200/50 backdrop-blur">
              <div className="flex items-center gap-3">
                <div className="grid h-11 w-11 place-items-center rounded-2xl bg-[#eef4ff] text-[#1f62ff]">
                  <MousePointer2 size={20} />
